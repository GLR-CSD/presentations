{
  "name": "glr-csd-presentations",
  "version": "1.0.0",
  "private": true,
  "description": "Reveal.js presentatie-monorepo voor de opleiding Creative Software Developer (MBO 4) van het Grafisch Lyceum Rotterdam.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/vendor-reveal.js && node scripts/vendor-plugins.js && node scripts/vendor-editor.js",
    "build:index": "node scripts/build-index.js",
    "build": "npm run vendor && npm run build:index",
    "export:pdf": "node scripts/export-pdf.js",
    "export:pdf:cached": "node scripts/export-pdf-cached.js",
    "test:roundtrip": "node scripts/test-roundtrip.js",
    "test:bridge": "node scripts/test-bridge.js",
    "serve": "serve .",
    "test:parsers": "node scripts/test-parsers.js",
    "mcp": "node scripts/mcp-server.js",
    "test:mcp": "node scripts/test-mcp.js",
    "test:deploy": "node scripts/test-deploy-poller.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "katex": "^0.19.1",
    "reveal.js": "^5.2.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@actions/cache": "^6.3.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "esbuild": "^0.28.2",
    "markdown-it": "^14.1.0",
    "octokit": "^5.0.5",
    "serve": "^14.2.6",
    "sortablejs": "^1.15.7"
  }
}
