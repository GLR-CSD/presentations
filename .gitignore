# Node afhankelijkheden en build-output
node_modules/
dist/

# Gekopieerde reveal.js-distributie (genereer met `npm run vendor`)
shared/vendor/

# Gebundelde GLR Slide Studio (esbuild-output; genereer met `npm run vendor`)
admin/vendor/

# Gegenereerd deck-manifest voor de Slide Studio (genereer met `npm run build:index`)
admin/presentations-manifest.json

# Gegenereerde Studio-config (Worker-URL uit env GLR_OAUTH_URL)
admin/studio-config.json

# Lokale brondocumenten en staging (alles negeren, behalve gitkeep)
input/*
!input/.gitkeep

# Lokale omgevingsvariabelen en OS-bestanden
.env
.DS_Store
Thumbs.db

# Gegenereerde PDF-bestanden tijdens lokale tests
*.pdf